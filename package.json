{
	"name": "wisycom-mat",
	"version": "0.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phillipivan/companion-module-wisycom-mat.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.0.3",
		"companion-module-utils": "~0.5.0",
		"es-toolkit": "^1.45.1",
		"p-queue": "~9.1.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.0",
		"@types/node": "^22.19.15",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.58.0"
	},
	"engines": {
		"node": "^22.20"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.13.0"
}
