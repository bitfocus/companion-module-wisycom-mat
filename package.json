{
	"name": "wisycom-mat",
	"version": "1.0.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"test": "vitest --run"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-wisycom-mat.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.2",
		"es-toolkit": "^1.50.0",
		"p-queue": "~9.3.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.2",
		"@types/node": "^26.1.2",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": "^26.7"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0"
}
